public/
.quartz/
.quartz-cache/
prof/

# Dependencies — installed via `npm ci` in builder stage
node_modules/

# Git metadata
.git/
.gitignore

# IDE / editor config
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Docker itself
Dockerfile
.dockerignore

# Docs / maintenance files (not needed at runtime)
docs/
MAINTENANCE-PLAN.md
